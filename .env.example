# Copy to .env and adjust as needed.
# Database URL. Default is a local SQLite file (zero setup).
DATABASE_URL=sqlite:///./data/jobcopilot.db

# CORS: comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DOL LCA disclosure file URL (H-1B sponsor data). DOL rotates the filename
# each fiscal quarter; update this to the current file if auto-download 404s.
DOL_SOURCE_URL=https://www.dol.gov/sites/dolgov/files/ETA/oflc/pdfs/LCA_Disclosure_Data_FY2025_Q3.xlsx

# USCIS H-1B Employer Data Hub CSV (actual petition approvals/denials).
# Download a fiscal-year file from:
# https://www.uscis.gov/tools/reports-studies/h-1b-employer-data-hub-files
# Leave blank to use the manual "Import USCIS File" option instead.
USCIS_SOURCE_URL=

# NOTE: Do NOT store job-portal passwords here or anywhere in this app.
